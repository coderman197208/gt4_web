generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// parameter_set 表无主键，无法映射为 Prisma model。
// 使用 PrismaClient.$queryRaw / $executeRaw 进行原生 SQL 操作。
// 报警模块的部分索引（如 partial unique index）由初始化脚本维护。
// 实际报警表结构使用 VARCHAR + CHECK 约束，而不是 PostgreSQL enum。

model AlarmArea {
  id                        Int               @id @default(autoincrement())
  area_code                 String            @unique @db.VarChar(64)
  area_name                 String            @db.VarChar(128)
  sort_order                Int               @default(0)
  enabled                   Boolean           @default(true)
  created_at                DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                DateTime          @default(now()) @db.Timestamptz(6)
  alarm_definition_defaults AlarmDefinition[] @relation("AlarmDefinitionDefaultArea")
  alarm_events              AlarmEvent[]      @relation("AlarmEventArea")
  user_areas                UserArea[]        @relation("UserAreaArea")

  @@map("alarm_area")
}

model UserArea {
  user_id    Int
  area_id    Int
  is_default Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  area       AlarmArea @relation("UserAreaArea", fields: [area_id], references: [id], onDelete: Cascade)

  @@id([user_id, area_id])
  @@index([user_id], map: "idx_user_area_user")
  @@map("user_area")
}

model AlarmDefinition {
  id               Int                 @id @default(autoincrement())
  alarm_code       String              @unique @db.VarChar(64)
  alarm_name       String              @db.VarChar(128)
  severity         String              @db.VarChar(16)
  source_module    String              @db.VarChar(64)
  default_area_id  Int?
  confirm_required Boolean             @default(true)
  auto_clear       Boolean             @default(false)
  dedupe_strategy  String              @default("by_dedupe_key") @db.VarChar(32)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @db.Timestamptz(6)
  default_area     AlarmArea?          @relation("AlarmDefinitionDefaultArea", fields: [default_area_id], references: [id])
  events           AlarmEvent[]

  @@index([source_module], map: "idx_alarm_definition_source_module")
  @@map("alarm_definition")
}

model AlarmEvent {
  id               Int                 @id @default(autoincrement())
  definition_id    Int?
  alarm_code       String              @db.VarChar(64)
  area_id          Int
  source_module    String              @db.VarChar(64)
  source_key       String              @db.VarChar(128)
  severity         String              @db.VarChar(16)
  title            String              @db.VarChar(256)
  message          String              @db.Text
  detail_json      Json                @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  condition_state  String              @db.VarChar(16)
  ack_state        String              @db.VarChar(16)
  first_occurred_at DateTime           @db.Timestamptz(6)
  last_occurred_at  DateTime           @db.Timestamptz(6)
  cleared_at        DateTime?          @db.Timestamptz(6)
  acked_at          DateTime?          @db.Timestamptz(6)
  acked_by_user_id  Int?
  acked_by_name     String?            @db.VarChar(64)
  dedupe_key        String             @db.VarChar(256)
  reopen_count      Int                @default(0)
  version           Int                @default(1)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  area              AlarmArea          @relation("AlarmEventArea", fields: [area_id], references: [id])
  definition        AlarmDefinition?   @relation(fields: [definition_id], references: [id])
  logs              AlarmEventLog[]

  @@index([dedupe_key], map: "idx_alarm_event_dedupe_key")
  @@index([area_id, condition_state, ack_state], map: "idx_alarm_event_area_state")
  @@index([alarm_code, source_module, source_key], map: "idx_alarm_event_code_source")
  @@map("alarm_event")
}

model AlarmEventLog {
  id            Int               @id @default(autoincrement())
  alarm_event_id Int
  action        String            @db.VarChar(16)
  operator_type String            @db.VarChar(16)
  operator_id   Int?
  operator_name String?           @db.VarChar(64)
  payload_json  Json              @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  alarm_event   AlarmEvent        @relation(fields: [alarm_event_id], references: [id], onDelete: Cascade)

  @@index([alarm_event_id, created_at], map: "idx_alarm_event_log_event_time")
  @@map("alarm_event_log")
}
